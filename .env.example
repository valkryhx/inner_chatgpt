# Hlaudz 环境变量模板
#
# 用法：
#   1) cp .env.example .env      （PowerShell: Copy-Item .env.example .env）
#   2) 按需取消注释并改值
#   3) 重启后端生效（python run.py）
#
# 优先级：**真实环境变量 > .env**
#   临时覆盖仍可用 `$env:FOO="x"; python run.py`，它会盖过本文件。
#
# 安全：.env 已在 .gitignore 里排除，绝不要提交。
# 本文件（.env.example）只放键名与说明，不放任何真实密钥。

# ============================================================
# 认证
# ============================================================
# JWT 签名密钥。生产环境必须改，且要足够随机。
# 不设置时回落到开发默认值 "dev-secret-change-me-inner-chatgpt"。
# APP_JWT_SECRET=change-me-to-a-long-random-string
# APP_ACCESS_TTL_SECONDS=3600
# APP_REFRESH_TTL_SECONDS=2592000

# ============================================================
# 日志
# ============================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR
# HLZ_LOG_LEVEL=INFO
# 应用日志落盘开关（默认开启）
# HLZ_APP_LOG_ON=1
# 应用日志路径（默认 backend/data/logs/app.log）
# HLZ_APP_LOG=
# Team 协作事件日志（JSONL，可用 tools/team_timeline.py 还原时间线）
# HLZ_TEAM_LOG=

# ============================================================
# LLM 调用韧性（L1 重试预算）
# ============================================================
# 单次模型调用的最大重试次数（默认 4，硬上限 8）
# HLZ_LLM_MAX_RETRIES=4
# Agent 循环层的重试上限
# HLZ_AGENT_LLM_RETRIES=
# lead agent 等待队友完成时最多续跑几轮
# HLZ_LEAD_TEAM_GRACE_TURNS=

# ============================================================
# 工具结果预算
# ============================================================
# 单个工具结果进 history 的最大字符数
# HLZ_TOOL_RESULT_MAX_CHARS=
# 超限时落盘并保留的头尾预览字符数
# HLZ_TOOL_RESULT_PREVIEW_CHARS=
# HLZ_TOOL_RESULT_FALLBACK_PREVIEW=
# 落盘文件的保留上限
# HLZ_TOOL_RESULT_PERSIST_LIMIT=

# ============================================================
# 并发闸门（进程内；单副本部署）
# ============================================================
# GLOBAL_MAX_ACTIVE_TEAMS=16
# 会话级已保证「一会话一 Team」；用户级只负责跨用户公平性。
# 设为 1 会让同一用户的第二个会话/标签页拿到 team_unavailable。
# USER_MAX_ACTIVE_TEAMS=4
# SESSION_MAX_ACTIVE_TEAMS=1
# TEAM_MAX_ACTIVE_SUBAGENTS=4
# USER_MAX_ACTIVE_SUBAGENTS=8
# GLOBAL_MAX_ACTIVE_SUBAGENTS=64
# USER_MAX_CODE_RUNS=2
# GLOBAL_MAX_CODE_RUNS=8
# USER_MAX_MCP_CALLS=2
# GLOBAL_MAX_MCP_CALLS=32

# ============================================================
# 主 Agent 轮数
# ============================================================
# AGENT_MAX_TURNS=300
# AGENT_SOFT_LIMIT=
# AGENT_HARD_LIMIT=
# AGENT_RECURSION_LIMIT=

# ============================================================
# A2A（对外调用面）—— 默认关闭
# ============================================================
# 开启后暴露 AgentCard / JSON-RPC / token API；关闭时全部 404
# INNER_A2A_ENABLED=false
# 对外基址（生成 AgentCard 里的 url 用）
# INNER_A2A_PUBLIC_BASE_URL=http://127.0.0.1:8000
# INNER_A2A_SYNC_TIMEOUT_S=60
# INNER_A2A_MAX_ACTIVE_TASKS_PER_USER=2
# INNER_A2A_MAX_ACTIVE_GLOBAL=16

# ============================================================
# ACP（外部 GenericAgent）—— 不配置即关闭
# ============================================================
# 注意：以下 INNER_ACP_* 由 Hlaudz 自己读取，用于决定「怎么启动 GA」；
#       它们不会被透传给 GA 子进程（见 app/acp/config.py 的 build_child_env）。
#
# 启用方式（二选一）：
#   方式 A——只给解释器，自动补 `-m frontends.acp.genericagent_acp_bridge`
# INNER_ACP_GA_PYTHON=C:/anaconda3/python.exe
#   方式 B——给完整命令行（JSON 数组或普通字符串都可以）
# INNER_ACP_GA_COMMAND=["C:/anaconda3/python.exe","-m","frontends.acp.genericagent_acp_bridge"]
#
# 权限模式：full_access / ask / read_only
# INNER_ACP_MODE=full_access
# 权限应答策略
# INNER_ACP_PERMISSION=allow
# GA 的工作目录模式
# INNER_ACP_WORKDIR_MODE=workspace
#
# 并发与名额
# INNER_ACP_MAX_ACTIVE_USER=4
# INNER_ACP_MAX_ACTIVE_GLOBAL=80
# INNER_ACP_MAX_OPEN_USER=8
#
# 超时与回收（秒）
# INNER_ACP_PROMPT_TIMEOUT_S=1800
# INNER_ACP_DRAIN_TIMEOUT_S=300
# INNER_ACP_IDLE_TTL_S=600
# INNER_ACP_STDERR_LINES=200
#
# GA 的 LLM profile 编号（对应 %APPDATA%/GenericAgent/llm.yaml）
# INNER_ACP_GA_LLM_NO=
# 指定 GA 使用的 MCP 配置（会以 GA_MCP_CONFIG 传给子进程）
# INNER_ACP_GA_MCP_CONFIG=
# 额外透传给 GA 的环境变量（逗号分隔）
# INNER_ACP_ENV_ALLOW=

# ============================================================
# GA 自身读取的变量（Hlaudz 会按白名单透传给 GA 子进程）
# ============================================================
# GA_CONFIG_DIR=
# GA_LLM_CONFIG=
# GA_MCP_CONFIG=
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=